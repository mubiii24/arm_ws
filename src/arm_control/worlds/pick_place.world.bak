<?xml version="1.0" ?>

<sdf version="1.6">

  <world name="pick_place_world">

    <include>
      <uri>model://ground_plane</uri>
    </include>

    <include>
      <uri>model://sun</uri>
    </include>

    <!-- Red object -->
    <model name="red_object">

      <static>true</static>

      <pose>0.6 0 0.1 0 0 0</pose>

      <link name="object_link">

        <visual name="visual">

          <geometry>
            <box>
              <size>0.2 0.2 0.2</size>
            </box>
          </geometry>

          <material>
            <ambient>1 0 0 1</ambient>
            <diffuse>1 0 0 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>

        </visual>

        <collision name="collision">

          <geometry>
            <box>
              <size>0.2 0.2 0.2</size>
            </box>
          </geometry>

        </collision>

      </link>

    </model>

  </world>

</sdf>
