<?xml version="1.0"?>

<robot name="simple_arm">

  <!-- ==================== BASE ==================== -->

  <link name="base_link">
    <visual>
      <geometry>
        <box size="0.4 0.4 0.2"/>
      </geometry>
    </visual>

    <collision>
      <geometry>
        <box size="0.4 0.4 0.2"/>
      </geometry>
    </collision>

    <inertial>
      <mass value="1.0"/>
      <origin xyz="0 0 0"/>
      <inertia
        ixx="0.01"
        ixy="0"
        ixz="0"
        iyy="0.01"
        iyz="0"
        izz="0.01"/>
    </inertial>
  </link>


  <!-- ==================== SHOULDER ==================== -->

  <link name="shoulder_link">
    <visual>
      <origin xyz="0 0 0.25"/>
      <geometry>
        <cylinder radius="0.08" length="0.5"/>
      </geometry>
    </visual>

    <collision>
      <origin xyz="0 0 0.25"/>
      <geometry>
        <cylinder radius="0.08" length="0.5"/>
      </geometry>
    </collision>

    <inertial>
      <mass value="0.5"/>
      <origin xyz="0 0 0.25"/>
      <inertia
        ixx="0.01"
        ixy="0"
        ixz="0"
        iyy="0.01"
        iyz="0"
        izz="0.01"/>
    </inertial>
  </link>

  <joint name="shoulder_joint" type="revolute">
    <parent link="base_link"/>
    <child link="shoulder_link"/>

    <origin xyz="0 0 0.1"/>

    <axis xyz="0 1 0"/>

    <limit
      lower="-1.57"
      upper="1.57"
      effort="10"
      velocity="1.0"/>
  </joint>


  <!-- ==================== ELBOW ==================== -->

  <link name="elbow_link">
    <visual>
      <origin xyz="0 0 0.25"/>
      <geometry>
        <cylinder radius="0.06" length="0.5"/>
      </geometry>
    </visual>

    <collision>
      <origin xyz="0 0 0.25"/>
      <geometry>
        <cylinder radius="0.06" length="0.5"/>
      </geometry>
    </collision>

    <inertial>
      <mass value="0.4"/>
      <origin xyz="0 0 0.25"/>
      <inertia
        ixx="0.008"
        ixy="0"
        ixz="0"
        iyy="0.008"
        iyz="0"
        izz="0.008"/>
    </inertial>
  </link>

  <joint name="elbow_joint" type="revolute">
    <parent link="shoulder_link"/>
    <child link="elbow_link"/>

    <origin xyz="0 0 0.5"/>

    <axis xyz="0 1 0"/>

    <limit
      lower="-1.57"
      upper="1.57"
      effort="10"
      velocity="1.0"/>
  </joint>


  <!-- ==================== WRIST ==================== -->

  <link name="wrist_link">
    <visual>
      <origin xyz="0 0 0.1"/>
      <geometry>
        <cylinder radius="0.05" length="0.2"/>
      </geometry>
    </visual>

    <collision>
      <origin xyz="0 0 0.1"/>
      <geometry>
        <cylinder radius="0.05" length="0.2"/>
      </geometry>
    </collision>

    <inertial>
      <mass value="0.2"/>
      <origin xyz="0 0 0.1"/>
      <inertia
        ixx="0.003"
        ixy="0"
        ixz="0"
        iyy="0.003"
        iyz="0"
        izz="0.003"/>
    </inertial>
  </link>

  <joint name="wrist_joint" type="revolute">
    <parent link="elbow_link"/>
    <child link="wrist_link"/>

    <origin xyz="0 0 0.5"/>

    <axis xyz="0 1 0"/>

    <limit
      lower="-1.57"
      upper="1.57"
      effort="5"
      velocity="1.0"/>
  </joint>


  <!-- ==================== LEFT FINGER ==================== -->

  <link name="left_finger_link">
    <visual>
      <origin xyz="0 0 0.1"/>
      <geometry>
        <box size="0.12 0.08 0.2"/>
      </geometry>
    </visual>

    <collision>
      <origin xyz="0 0 0.1"/>
      <geometry>
        <box size="0.12 0.08 0.2"/>
      </geometry>
    </collision>

    <inertial>
      <mass value="0.1"/>
      <origin xyz="0 0 0.1"/>
      <inertia
        ixx="0.001"
        ixy="0"
        ixz="0"
        iyy="0.001"
        iyz="0"
        izz="0.001"/>
    </inertial>
  </link>

  <joint name="left_finger_joint" type="prismatic">
    <parent link="wrist_link"/>
    <child link="left_finger_link"/>

    <origin xyz="0.06 0 0.2"/>

    <axis xyz="1 0 0"/>

    <limit
      lower="0.0"
      upper="0.06"
      effort="5"
      velocity="0.1"/>
  </joint>


  <!-- ==================== RIGHT FINGER ==================== -->

  <link name="right_finger_link">
    <visual>
      <origin xyz="0 0 0.1"/>
      <geometry>
        <box size="0.12 0.08 0.2"/>
      </geometry>
    </visual>

    <collision>
      <origin xyz="0 0 0.1"/>
      <geometry>
        <box size="0.12 0.08 0.2"/>
      </geometry>
    </collision>

    <inertial>
      <mass value="0.1"/>
      <origin xyz="0 0 0.1"/>
      <inertia
        ixx="0.001"
        ixy="0"
        ixz="0"
        iyy="0.001"
        iyz="0"
        izz="0.001"/>
    </inertial>
  </link>

  <joint name="right_finger_joint" type="prismatic">
    <parent link="wrist_link"/>
    <child link="right_finger_link"/>

    <origin xyz="-0.06 0 0.2"/>

    <axis xyz="1 0 0"/>

    <limit
      lower="-0.06"
      upper="0.0"
      effort="5"
      velocity="0.1"/>
  </joint>


  <!-- ==================== ROS2 CONTROL ==================== -->

  <ros2_control name="GazeboSystem" type="system">

    <hardware>
      <plugin>gazebo_ros2_control/GazeboSystem</plugin>
    </hardware>

    <joint name="shoulder_joint">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <joint name="elbow_joint">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <joint name="wrist_joint">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <joint name="left_finger_joint">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <joint name="right_finger_joint">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

  </ros2_control>


  <!-- ==================== GAZEBO CONTROL ==================== -->

  <gazebo>

    <plugin
      filename="libgazebo_ros2_control.so"
      name="gazebo_ros2_control">

      <parameters>
        /home/mubii/arm_ws/src/arm_control/config/controllers.yaml
      </parameters>

    </plugin>

  </gazebo>


  <!-- ==================== CAMERA ==================== -->

  <link name="camera_link">

    <visual>
      <geometry>
        <box size="0.08 0.08 0.05"/>
      </geometry>
    </visual>

    <collision>
      <geometry>
        <box size="0.08 0.08 0.05"/>
      </geometry>
    </collision>

    <inertial>
      <mass value="0.05"/>
      <origin xyz="0 0 0"/>

      <inertia
        ixx="0.0001"
        ixy="0"
        ixz="0"
        iyy="0.0001"
        iyz="0"
        izz="0.0001"/>
    </inertial>

  </link>


  <!-- Camera orientation -->
  <joint name="camera_joint" type="fixed">

    <parent link="wrist_link"/>
    <child link="camera_link"/>

    <origin
      xyz="0 0 0.25"
      rpy="0 1.5708 0"/>

  </joint>


  <!-- Gazebo camera sensor -->

  <gazebo reference="camera_link">

    <sensor
      name="arm_camera"
      type="camera">

      <always_on>true</always_on>

      <update_rate>30</update_rate>

      <visualize>true</visualize>

      <camera>

        <horizontal_fov>1.047</horizontal_fov>

        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>

        <clip>
          <near>0.05</near>
          <far>10.0</far>
        </clip>

      </camera>

      <plugin
        name="camera_controller"
        filename="libgazebo_ros_camera.so">

        <alwaysOn>true</alwaysOn>

        <updateRate>30.0</updateRate>

        <cameraName>arm_camera</cameraName>

        <imageTopicName>image_raw</imageTopicName>

        <cameraInfoTopicName>camera_info</cameraInfoTopicName>

        <frameName>camera_link</frameName>

      </plugin>

    </sensor>

  </gazebo>

</robot>
