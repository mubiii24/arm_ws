<?xml version="1.0"?>
<robot name="simple_arm">
  <material name="grey"><color rgba="0.5 0.5 0.5 1"/></material>
  <material name="blue"><color rgba="0.2 0.4 0.9 1"/></material>
  <material name="black"><color rgba="0.1 0.1 0.1 1"/></material>

  <link name="world"/>
  <joint name="world_joint" type="fixed"><parent link="world"/><child link="base_link"/></joint>

  <link name="base_link">
    <visual><origin xyz="0 0 0.025"/><geometry><cylinder radius="0.08" length="0.05"/></geometry><material name="grey"/></visual>
    <collision><origin xyz="0 0 0.025"/><geometry><cylinder radius="0.08" length="0.05"/></geometry></collision>
    <inertial><mass value="2"/><inertia ixx="0.01" iyy="0.01" izz="0.01" ixy="0" ixz="0" iyz="0"/></inertial>
  </link>

  <joint name="base_yaw_joint" type="revolute">
    <parent link="base_link"/><child link="turret"/><origin xyz="0 0 0.05"/>
    <axis xyz="0 0 1"/><dynamics damping="1.0" friction="0.1"/>
    <limit lower="-3.14" upper="3.14" effort="50" velocity="2"/>
  </joint>
  <link name="turret">
    <visual><origin xyz="0 0 0.05"/><geometry><cylinder radius="0.05" length="0.1"/></geometry><material name="blue"/></visual>
    <collision><origin xyz="0 0 0.05"/><geometry><cylinder radius="0.05" length="0.1"/></geometry></collision>
    <inertial><mass value="1"/><inertia ixx="0.005" iyy="0.005" izz="0.005" ixy="0" ixz="0" iyz="0"/></inertial>
  </link>

  <joint name="shoulder_joint" type="revolute">
    <parent link="turret"/><child link="upper_arm"/><origin xyz="0 0 0.1"/>
    <axis xyz="0 1 0"/><dynamics damping="1.0" friction="0.1"/>
    <limit lower="-2.0" upper="2.0" effort="50" velocity="2"/>
  </joint>
  <link name="upper_arm">
    <visual><origin xyz="0 0 0.2"/><geometry><box size="0.06 0.06 0.4"/></geometry><material name="grey"/></visual>
    <collision><origin xyz="0 0 0.2"/><geometry><box size="0.06 0.06 0.4"/></geometry></collision>
    <inertial><origin xyz="0 0 0.2"/><mass value="1"/><inertia ixx="0.01" iyy="0.01" izz="0.002" ixy="0" ixz="0" iyz="0"/></inertial>
  </link>

  <joint name="elbow_joint" type="revolute">
    <parent link="upper_arm"/><child link="forearm"/><origin xyz="0 0 0.4"/>
    <axis xyz="0 1 0"/><dynamics damping="1.0" friction="0.1"/>
    <limit lower="-2.4" upper="2.4" effort="40" velocity="2"/>
  </joint>
  <link name="forearm">
    <visual><origin xyz="0 0 0.175"/><geometry><box size="0.05 0.05 0.35"/></geometry><material name="blue"/></visual>
    <collision><origin xyz="0 0 0.175"/><geometry><box size="0.05 0.05 0.35"/></geometry></collision>
    <inertial><origin xyz="0 0 0.175"/><mass value="0.8"/><inertia ixx="0.008" iyy="0.008" izz="0.001" ixy="0" ixz="0" iyz="0"/></inertial>
  </link>

  <joint name="wrist_roll_joint" type="revolute">
    <parent link="forearm"/><child link="wrist_roll_link"/><origin xyz="0 0 0.35"/>
    <axis xyz="0 0 1"/><dynamics damping="0.5" friction="0.05"/>
    <limit lower="-3.14" upper="3.14" effort="20" velocity="3"/>
  </joint>
  <link name="wrist_roll_link">
    <visual><origin xyz="0 0 0.02"/><geometry><cylinder radius="0.03" length="0.04"/></geometry><material name="black"/></visual>
    <inertial><mass value="0.1"/><inertia ixx="0.0002" iyy="0.0002" izz="0.0002" ixy="0" ixz="0" iyz="0"/></inertial>
  </link>

  <joint name="wrist_pitch_joint" type="revolute">
    <parent link="wrist_roll_link"/><child link="wrist_pitch_link"/><origin xyz="0 0 0.04"/>
    <axis xyz="0 1 0"/><dynamics damping="0.5" friction="0.05"/>
    <limit lower="-1.9" upper="1.9" effort="20" velocity="3"/>
  </joint>
  <link name="wrist_pitch_link">
    <visual><origin xyz="0 0 0.02"/><geometry><cylinder radius="0.025" length="0.04"/></geometry><material name="grey"/></visual>
    <inertial><mass value="0.1"/><inertia ixx="0.0002" iyy="0.0002" izz="0.0002" ixy="0" ixz="0" iyz="0"/></inertial>
  </link>

  <joint name="wrist_yaw_joint" type="revolute">
    <parent link="wrist_pitch_link"/><child link="wrist_yaw_link"/><origin xyz="0 0 0.04"/>
    <axis xyz="1 0 0"/><dynamics damping="0.5" friction="0.05"/>
    <limit lower="-1.9" upper="1.9" effort="20" velocity="3"/>
  </joint>
  <link name="wrist_yaw_link">
    <visual><origin xyz="0 0 0.02"/><geometry><cylinder radius="0.025" length="0.04"/></geometry><material name="black"/></visual>
    <inertial><mass value="0.1"/><inertia ixx="0.0002" iyy="0.0002" izz="0.0002" ixy="0" ixz="0" iyz="0"/></inertial>
  </link>

  <joint name="hand_joint" type="fixed">
    <parent link="wrist_yaw_link"/><child link="hand"/>
    <origin xyz="0 0 0.04" rpy="0 -1.5708 0"/>
  </joint>
  <link name="hand">
    <visual><origin xyz="0.015 0 0"/><geometry><box size="0.03 0.08 0.04"/></geometry><material name="grey"/></visual>
    <collision><origin xyz="0.015 0 0"/><geometry><box size="0.03 0.08 0.04"/></geometry></collision>
    <inertial><mass value="0.2"/><inertia ixx="0.0005" iyy="0.0005" izz="0.0005" ixy="0" ixz="0" iyz="0"/></inertial>
  </link>

  <joint name="camera_joint" type="fixed">
    <parent link="hand"/><child link="camera_link"/><origin xyz="0.03 0 0"/>
  </joint>
  <link name="camera_link">
    <visual><geometry><box size="0.015 0.03 0.015"/></geometry><material name="black"/></visual>
    <inertial><mass value="0.01"/><inertia ixx="0.00001" iyy="0.00001" izz="0.00001" ixy="0" ixz="0" iyz="0"/></inertial>
  </link>

  <joint name="left_finger_joint" type="prismatic"><parent link="hand"/><child link="left_finger"/><origin xyz="0.03 0.05 0"/><axis xyz="0 -1 0"/><dynamics damping="5.0" friction="0.1"/><limit lower="0.0" upper="0.04" effort="30" velocity="0.2"/></joint><link name="left_finger"><visual><origin xyz="0.04 0 0"/><geometry><box size="0.08 0.01 0.03"/></geometry><material name="black"/></visual><collision><origin xyz="0.04 0 0"/><geometry><box size="0.08 0.01 0.03"/></geometry></collision><inertial><origin xyz="0.04 0 0"/><mass value="0.1"/><inertia ixx="0.0001" iyy="0.0001" izz="0.0001" ixy="0" ixz="0" iyz="0"/></inertial></link>

  <joint name="right_finger_joint" type="prismatic"><parent link="hand"/><child link="right_finger"/><origin xyz="0.03 -0.05 0"/><axis xyz="0 1 0"/><dynamics damping="5.0" friction="0.1"/><limit lower="0.0" upper="0.04" effort="30" velocity="0.2"/></joint><link name="right_finger"><visual><origin xyz="0.04 0 0"/><geometry><box size="0.08 0.01 0.03"/></geometry><material name="black"/></visual><collision><origin xyz="0.04 0 0"/><geometry><box size="0.08 0.01 0.03"/></geometry></collision><inertial><origin xyz="0.04 0 0"/><mass value="0.1"/><inertia ixx="0.0001" iyy="0.0001" izz="0.0001" ixy="0" ixz="0" iyz="0"/></inertial></link>

  
  <gazebo reference="turret"></gazebo>
  <gazebo reference="upper_arm"></gazebo>
  <gazebo reference="forearm"></gazebo>
  <gazebo reference="wrist_roll_link"></gazebo>
  <gazebo reference="wrist_pitch_link"></gazebo>
  <gazebo reference="wrist_yaw_link"></gazebo>
  <gazebo reference="hand"></gazebo>
  <gazebo reference="camera_link"></gazebo>
  
  

  <gazebo reference="camera_link">
    <sensor type="camera" name="gripper_camera">
      <update_rate>15</update_rate>
      <always_on>true</always_on>
      <camera>
        <horizontal_fov>1.2</horizontal_fov>
        <image><width>320</width><height>240</height><format>R8G8B8</format></image>
        <clip><near>0.02</near><far>3.0</far></clip>
      </camera>
      <plugin name="camera_controller" filename="libgazebo_ros_camera.so">
        <ros><namespace>/gripper_camera</namespace></ros>
        <camera_name>cam</camera_name>
        <frame_name>camera_link</frame_name>
      </plugin>
    </sensor>
  </gazebo>

  <gazebo reference="base_link"><kp>100000</kp><kd>100</kd><minDepth>0.002</minDepth><maxVel>0.05</maxVel><mu1>0.5</mu1><mu2>0.5</mu2></gazebo><gazebo reference="turret"><kp>100000</kp><kd>100</kd><minDepth>0.002</minDepth><maxVel>0.05</maxVel><mu1>0.5</mu1><mu2>0.5</mu2></gazebo><gazebo reference="upper_arm"><kp>100000</kp><kd>100</kd><minDepth>0.002</minDepth><maxVel>0.05</maxVel><mu1>0.5</mu1><mu2>0.5</mu2></gazebo><gazebo reference="forearm"><kp>100000</kp><kd>100</kd><minDepth>0.002</minDepth><maxVel>0.05</maxVel><mu1>0.5</mu1><mu2>0.5</mu2></gazebo><gazebo reference="hand"><kp>100000</kp><kd>100</kd><minDepth>0.002</minDepth><maxVel>0.05</maxVel><mu1>0.5</mu1><mu2>0.5</mu2></gazebo><ros2_control name="GazeboSystem" type="system">
    <hardware><plugin>gazebo_ros2_control/GazeboSystem</plugin></hardware>
    <joint name="base_yaw_joint"><command_interface name="position"/><state_interface name="position"/><state_interface name="velocity"/></joint>
    <joint name="shoulder_joint"><command_interface name="position"/><state_interface name="position"/><state_interface name="velocity"/></joint>
    <joint name="elbow_joint"><command_interface name="position"/><state_interface name="position"/><state_interface name="velocity"/></joint>
    <joint name="wrist_roll_joint"><command_interface name="position"/><state_interface name="position"/><state_interface name="velocity"/></joint>
    <joint name="wrist_pitch_joint"><command_interface name="position"/><state_interface name="position"/><state_interface name="velocity"/></joint>
    <joint name="wrist_yaw_joint"><command_interface name="position"/><state_interface name="position"/><state_interface name="velocity"/></joint>
    <joint name="left_finger_joint"><command_interface name="position"/><state_interface name="position"/><state_interface name="velocity"/></joint>
    <joint name="right_finger_joint"><command_interface name="position"/><state_interface name="position"/><state_interface name="velocity"/></joint>
  </ros2_control>

  <gazebo>
    <plugin name="gazebo_ros2_control" filename="libgazebo_ros2_control.so"><parameters>/home/mubii/arm_ws/install/arm_control/share/arm_control/config/controllers.yaml</parameters>
    </plugin>
  </gazebo>
</robot>
